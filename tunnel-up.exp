#!/usr/bin/expect -f
# Runs an ssh tunnel (passed as args) in the FOREGROUND, answering the ANL Duo
# menu with "1" (Duo Push). After auth it blocks on eof, i.e. it holds the ssh
# process alive for as long as the connection lasts. This is meant to be the main
# process of a launchd service (com.rbarik.minion-tunnel): launchd keeps it alive,
# and because ssh stays in the foreground there is no pty to close and SIGHUP it.
#
# Usage: expect -f tunnel-up.exp ssh -N -L ... -R ... homes.cels.anl.gov
#
# It must NEVER block during authentication. A hung pre-auth ssh keeps the launchd
# job in the "running" state forever, which silently turns every later restart into
# a no-op -- the watchdog then reports "approve the Duo push" with no push ever sent.
# So: answer the menu once, and exit non-zero on anything that means the push was
# not approved (an expired push makes the server print "Login timed out." and
# re-print the menu). Exiting lets the job go idle so the next check can retry.
set timeout 90
set answered 0
eval spawn $argv
expect {
    -re "Passcode or option" {
        if {$answered} { exit 4 }
        set answered 1
        send "1\r"
        exp_continue
    }
    "Login timed out"         { exit 4 }
    "Success. Logging you in" { }
    "Permission denied"       { exit 1 }
    timeout                   { exit 2 }
    eof                       { exit 3 }
}
# Auth answered and push approved -- now hold the tunnel open until ssh exits.
set timeout -1
expect eof

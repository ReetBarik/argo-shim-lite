<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rbarik.minion-proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rbarik/argo-shim-lite/.venv/bin/python3</string>
        <string>/Users/rbarik/argo-shim-lite/hermes-argo-proxy.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ARGO_USER</key>
        <string>rbarik</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/rbarik/.minion-logs/proxy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rbarik/.minion-logs/proxy.log</string>
</dict>
</plist>
